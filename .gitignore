# Rendered overlays are NOT committed anymore: render.py runs INSIDE the
# agent image build (config/ → /overlay/<profile>), so a push to main is
# both the render step and the deploy trigger. Local `mise run render`
# output is a preview only — never commit it.

build/

# Per-machine mise overrides (mise set ...) — may contain local paths
mise.local.toml

# Real secrets — only *.env.example files are committed. bootstrap-host.sh
# copies the templates to /etc/hermes on the host.
secrets/*.env

# Python
__pycache__/
*.pyc

# Editors / OS
.DS_Store
.idea/
.vscode/
# Claude Code local settings
.claude/settings.local.json
admin-api-key.txt