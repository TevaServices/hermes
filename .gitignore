# Rendered overlays (render.py output) are COMMITTED: Komodo/periphery
# deploys straight from git and mounts build/<profile>/ into the agent
# containers, so a push to main is both the render step and the deploy
# trigger. After editing config/, run `mise run render` and commit the
# output along with the config change.

# Per-machine mise overrides (mise set ...) — may contain local paths
mise.local.toml

# Real secrets — only *.env.example files are committed. bootstrap-host.sh
# copies the templates to /etc/hermes on the host.
secrets/*.env

# Python
__pycache__/
*.pyc

# Editors / OS
.DS_Store
.idea/
.vscode/
# Claude Code local settings
.claude/settings.local.json
admin-api-key.txt
