# Rendered overlays are NOT committed anymore: render.py runs INSIDE the
# agent image build (config/ → /overlay/<profile>), so a push to main is
# both the render step and the deploy trigger. Local `mise run render`
# output is a preview only — never commit it.

build/

# Per-machine mise overrides (mise set ...) — may contain local paths
mise.local.toml

# The .claude/ skills/worktrees are local-tool state, not repo content
# (the project skill lives at .claude/skills/, tracked; local worktree
# copies are not).
.claude/worktrees/

# Profile package dead drops — the local stand-in for the host's
# <env-dir>/profiles.d/. A package's CONTENT belongs to its own repo
# (e.g. github.com/TevaServices/hermes-software-development); whatever
# gets provisioned here for local runs is that repo's checkout copy, and
# package.env carries real credentials.
secrets/profiles.d/

# Real secrets — only *.env.example files are committed. bootstrap-host.sh
# copies the templates to /etc/hermes on the host.
secrets/*.env

# GitHub App private keys are per-profile credentials — never committed.
# scripts/create-github-apps.py writes them to the gitignored build/ tree;
# this line is the backstop for anyone who drops one here by hand.
secrets/*.pem

# Python
__pycache__/
*.pyc

# Editors / OS
.DS_Store
.idea/
.vscode/
# Claude Code local settings
.claude/settings.local.json
admin-api-key.txt
# Backstop for other loose credential files dropped here by hand. The real
# home for these is /etc/hermes on the host (root-owned, 640) — this only
# stops a `git add -A` from committing one.
komodo_creds.txt