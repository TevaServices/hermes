# LiteLLM gateway's own Postgres (compose service litellm-db) — copy to
# /etc/hermes/litellm-db.env. Shares ONE generated password with the
# DATABASE_URL in /etc/hermes/litellm.env (see litellm.env.example); the
# two files are written in the same sitting so they cannot drift.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=litellm