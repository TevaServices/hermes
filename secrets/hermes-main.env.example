# Hermes "main" profile secrets — copy to /etc/hermes/hermes-main.env
# (scripts/bootstrap-host.sh) and fill in real values.
#
# Key names below come from:
#   - config/providers.toml  (api_key_env of the profile's model providers)
#   - profile.toml platforms  (gateway tokens)
#   - config/integrations.toml (required_env)
# After changing providers/models/platforms, check the rendered
# .env.example in the image (docker run --rm hermes-agent:v<ref> cat
# /overlay/default/.env.example) for the current required set.

# All model aliases route through the stack's LiteLLM gateway
# (config/providers.toml -> http://litellm:4000). LITELLM_API_KEY is the
# proxy's master key (LITELLM_MASTER_KEY in /etc/hermes/litellm.env) —
# keep the two in sync. The gateway holds the real upstream keys
# (Ollama Cloud, OpenRouter) and routes each model name among its group.
LITELLM_API_KEY=

# OPENAI_* mirror LITELLM_API_KEY for Hermes' provider-registry resolution.
# Not used by the custom_providers entry in config.yaml (that reads
# LITELLM_API_KEY directly), BUT the `hermes chat` first-run gate
# (_has_any_provider_configured) only looks at registry env vars — without
# these, chat exits with setup guidance even though the gateway works.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://litellm:4000

# Hermes' auxiliary side tasks (context compression, session search, web
# extract, skills hub) resolve via AUXILIARY_*_ env overrides, pinned to
# the LiteLLM gateway per the models.toml routing policy.
#
# The value is a TIER NAME from config/models.toml — a gateway model name,
# never an upstream model id. Which backend answers for a tier is
# config/litellm.yaml's business. Compression summarizes a potentially ~1M
# context, so it needs BOTH intelligence and the window: "smarter". The
# light tasks (search/extract/skills hub) ride "cheap". (Web extract reads
# public pages, but the URL can be an internal one, so it stays on a
# private backend rather than a free public one.)
#
# THIS FILE IS OUTSIDE THE REPO'S ATOMICITY: it is operator-owned, so a
# gateway-config change and the env edit that follows it are two separate
# acts. A value left on a raw ollama/<id> still ROUTES (the gateway's
# wildcard passthrough serves it) but loses its declared window — Hermes
# falls back to a guessed one, and for compression that sizes the ~1M lane
# wrongly. Update it in the same change that deploys the gateway config.
# Leave unset for provider auto-detection.
AUXILIARY_COMPRESSION_BASE_URL=http://litellm:4000
AUXILIARY_COMPRESSION_API_KEY=
AUXILIARY_COMPRESSION_MODEL=smarter
AUXILIARY_SESSION_SEARCH_BASE_URL=http://litellm:4000
AUXILIARY_SESSION_SEARCH_API_KEY=
AUXILIARY_SESSION_SEARCH_MODEL=cheap
AUXILIARY_WEB_EXTRACT_BASE_URL=http://litellm:4000
AUXILIARY_WEB_EXTRACT_API_KEY=
AUXILIARY_WEB_EXTRACT_MODEL=cheap
AUXILIARY_SKILLS_HUB_BASE_URL=http://litellm:4000
AUXILIARY_SKILLS_HUB_API_KEY=
AUXILIARY_SKILLS_HUB_MODEL=cheap

# Gateway platform (discord) — the token's mere presence enables the
# platform (gateway/config.py _apply_env_overrides). Create the app at
# https://discord.com/developers/applications, and in the Bot tab enable
# BOTH privileged toggles: "Message Content Intent" AND "Server Members
# Intent" — the adapter requests both and discord.py refuses to connect
# without them.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs the bot may respond to (accepts
# @usernames too — resolved to IDs at startup, which needs the Members
# intent). Empty = the bot answers ANYONE who mentions it in any server
# it's in. Set at least your own ID: enable Developer Mode in Discord's
# Advanced settings, right-click your name → "Copy User ID".
DISCORD_ALLOWED_USERS=
# The stack's "home channel" — where SYSTEM messages land: gateway
# shutdown/restart notices (gateway/config.py _apply_env_overrides ->
# PlatformConfig.home_channel -> run.py's home-channel broadcast, gated by
# gateway_restart_notification, default true), the one-time
# connect-time warning, and any cron job delivered with `all`/`home`
# routing instead of an explicit target. Not the bot's chat and not a
# per-profile channel: the declared housekeeping jobs in config/cron.toml
# name this ID explicitly, and this var is what covers the messages the
# gateway raises on its own. #hermes-home. Leave empty to keep system
# messages off Discord.
DISCORD_HOME_CHANNEL=
#
# Team channel routing. Each team profile answers ONLY in its own channel
# (config/profiles/<name>/profile.toml `allowed_channels`) and the default
# agent in #hermes + #hermes-home; the default profile's
# `gateway.profile_routes` sends each team channel to its profile. These
# are also what config/cron.toml's housekeeping jobs deliver to.
#
# Right-click the channel in Discord -> "Copy Channel ID". Leave a var
# empty and that profile is fenced out of every channel (it boots, but
# answers nowhere) — the boot log names the missing var.
DISCORD_CHANNEL_MAIN=
DISCORD_CHANNEL_PLANNER=
DISCORD_CHANNEL_DEVELOPER=
DISCORD_CHANNEL_REVIEWER=

# The GitHub account whose repos the team workflow operates on. The queue
# scripts scope every search to it, and they REFUSE to run when it is
# empty (an empty owner searches all of GitHub and returns strangers'
# issues). Not the same thing as the App owner: it is the repos'
# namespace. This is the PERSONAL owner — searched with the profile's own
# gh auth state.
TEAM_OWNER=
# ORG owners (space-separated) for the org GitHub Apps, e.g.
#   TEAM_OWNER_ORGS=AcmeCorp OtherCo
# Each is searched with that org's own App installation token (the
# org-creds descriptors the entrypoint wires from the vars below); an
# org with no resolvable credentials is an ORG CREDS MISSING incident
# (queue exit 6), never a silent skip.
TEAM_OWNER_ORGS=

# GitHub (gh CLI + git-over-HTTPS). Two modes — the GitHub App is
# preferred (least privilege, scoped to selected repos, no user
# account); GH_TOKEN (fine-grained PAT) is the fallback. Commits the
# agent creates get attributed to GH_GIT_NAME/GH_GIT_EMAIL.
#
# GitHub App mode: create the app at https://github.com/settings/apps/new
# with Contents / Issues / Pull requests read+write (Metadata read is
# mandatory), install it on the repos the agent may touch, and download
# the private key PEM to $HERMES_ENV_DIR/github-app-<profile>.pem
# (root:<host-group> 640 — mounted read-only into the profile's container;
# the default profile uses github-app-main.pem). Each profile gets its
# own app — the compose mount and GITHUB_APP_* vars are per service.
# App ID is on the app's About page; Installation ID is the number in
# the install URL (https://github.com/settings/installations/<id>).
# Installation tokens last 1h — entrypoint.sh refreshes gh every 30 min
# and git routes credentials through gh (gh auth git-credential).
# GITHUB_APP_PRIVATE_KEY_PATH is deliberately NOT set here: the PEM mount
# path is fixed by compose and the entrypoint copies the key into the
# runtime-owned tool-home, exporting the variable itself.
# Hermes' skills hub also has native app support (tools/skills_hub.py
# GitHubAuth).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
#
# Team profiles (planner / developer / reviewer) — per-profile
# credentials. The container receives these as PROFILE_<NAME>_<VAR>
# entries in THIS env file; entrypoint.sh maps them into each profile's
# own .env under the bare var name (PROFILE_DEVELOPER_DISCORD_BOT_TOKEN
# -> developer's DISCORD_BOT_TOKEN). Team-profile GitHub Apps follow the
# same creation flow as above (least-privilege per role — see
# config/skills/team-conventions/SKILL.md for the permission sets);
# their PEMs live at /etc/hermes/github-app-<profile>.pem.
#
# Planner (PM + design — Discord: #planning):
PROFILE_PLANNER_DISCORD_BOT_TOKEN=
# App NAME per profile, if the default (hermes-<role>) is taken on
# GitHub. App names are globally unique, and the value must match the
# App's slug — the bot identity commits carry is "<slug>[bot]".
PROFILE_PLANNER_GH_APP_NAME=
PROFILE_DEVELOPER_GH_APP_NAME=
PROFILE_REVIEWER_GH_APP_NAME=
#
PROFILE_PLANNER_GITHUB_APP_ID=
PROFILE_PLANNER_GITHUB_APP_INSTALLATION_ID=
PROFILE_PLANNER_GH_GIT_NAME=hermes-planner[bot]
PROFILE_PLANNER_GH_GIT_EMAIL=hermes-planner[bot]@users.noreply.github.com
# Developer (implementation, draft PRs — Discord: #dev):
PROFILE_DEVELOPER_DISCORD_BOT_TOKEN=
PROFILE_DEVELOPER_GITHUB_APP_ID=
PROFILE_DEVELOPER_GITHUB_APP_INSTALLATION_ID=
PROFILE_DEVELOPER_GH_GIT_NAME=hermes-dev[bot]
PROFILE_DEVELOPER_GH_GIT_EMAIL=hermes-dev[bot]@users.noreply.github.com
# Reviewer (gates + merges — Discord: #reviews):
PROFILE_REVIEWER_DISCORD_BOT_TOKEN=
PROFILE_REVIEWER_GITHUB_APP_ID=
PROFILE_REVIEWER_GITHUB_APP_INSTALLATION_ID=
PROFILE_REVIEWER_GH_GIT_NAME=hermes-reviewer[bot]
PROFILE_REVIEWER_GH_GIT_EMAIL=hermes-reviewer[bot]@users.noreply.github.com
#
# ── ORG Apps — the SECOND credential set per profile, one block per org ──
# Org-owned apps, created per org with:
#   python3 scripts/create-github-apps.py --org <ORG> main planner developer reviewer
# PEMs install on the host as github-app-<orgslug>-<profile>.pem
# (host-install-<orgslug>.sh); entrypoint.sh wires each tool-home's
# org-creds/<orgslug>.env descriptor from THESE vars. The entrypoint also
# needs a GITHUB_APP_INSTALLATION_ID_<ORG> for every declared app id —
# an org with ids but no installation id (or no PEM) is skipped with a
# boot warning and its repos simply fall back to the personal token.
# The routing model (which token runs where) is in the hermes-stack-ops
# skill and AGENTS.md §"GitHub access".
#
# ANY NUMBER of orgs: copy the block below once per org, replacing <ORG>
# with the org name uppercased (non-alphanumerics -> _, e.g.
# "Acme Corp" -> ACME_CORP) and <orgslug> with its lowercase slug
# (e.g. acmecorp). Provisioning's env-lines-<orgslug>.txt emits these
# lines filled in — paste them here.
#
# main (default profile):
GITHUB_APP_ID_<ORG>=
GITHUB_APP_INSTALLATION_ID_<ORG>=
GH_GIT_NAME_<ORG>=
GH_GIT_EMAIL_<ORG>=
# planner / developer / reviewer (repeat per profile per org):
PROFILE_PLANNER_GITHUB_APP_ID_<ORG>=
PROFILE_PLANNER_GITHUB_APP_INSTALLATION_ID_<ORG>=
PROFILE_PLANNER_GH_GIT_NAME_<ORG>=
PROFILE_PLANNER_GH_GIT_EMAIL_<ORG>=
PROFILE_DEVELOPER_GITHUB_APP_ID_<ORG>=
PROFILE_DEVELOPER_GITHUB_APP_INSTALLATION_ID_<ORG>=
PROFILE_DEVELOPER_GH_GIT_NAME_<ORG>=
PROFILE_DEVELOPER_GH_GIT_EMAIL_<ORG>=
PROFILE_REVIEWER_GITHUB_APP_ID_<ORG>=
PROFILE_REVIEWER_GITHUB_APP_INSTALLATION_ID_<ORG>=
PROFILE_REVIEWER_GH_GIT_NAME_<ORG>=
PROFILE_REVIEWER_GH_GIT_EMAIL_<ORG>=
# The org developer bot login — the author filter for that org's PR
# searches (one per org):
TEAM_ORG_DEV_BOT_<ORG>=
#
# PAT fallback: gh reads GH_TOKEN natively; entrypoint.sh wires git's
# credential helper through gh, so the token never lands in a config
# file. Also feeds Hermes' skills hub (reads GITHUB_TOKEN/GH_TOKEN).
# Prefer a fine-grained PAT scoped to just the repos the agent may touch
# with Contents/Issues/Pull requests read+write.
GH_TOKEN=
GH_GIT_NAME=
GH_GIT_EMAIL=

# Firecrawl (self-hosted API key — must match TEST_API_KEY in firecrawl.env)
FIRECRAWL_API_KEY=

# Honcho (only if auth is enabled on the Honcho instance)
HONCHO_API_KEY=

# ── Hermes dashboard (DISABLED by default) ──────────────────────────────
# The dashboard s6 service ships in the official image, gated by
# HERMES_DASHBOARD — which is NOT flipped here: compose declares
# HERMES_DASHBOARD in the container environment, and compose environment
# values override env_file values, so setting it in THIS file does
# nothing. Flip it in the stack environment (komodo/resources.toml's
# hermes-agents `environment`, or mise.toml [env] for local runs) and
# redeploy.
#
# The auth gate engages automatically on non-loopback binds and REQUIRES
# an auth provider (upstream hardening): with HERMES_DASHBOARD=1 and
# none of the vars below set, the dashboard fails at startup and its s6
# slot restart-loops (the rest of the container is unaffected). Set all
# three BEFORE flipping the flag.
#
#   username: any non-empty name you'll type at the login page
#   password: openssl rand -hex 24  (hashed in-memory at startup; a
#             precomputed scrypt hash may be supplied instead via
#             HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH)
#   secret:   openssl rand -hex 32  (session-token signing key; left
#             empty the dashboard generates a per-process key and
#             sessions do not survive a restart)
#   Optional: HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS (default 43200).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
#
# Optional alternative provider — self-hosted OIDC instead of the
# password login (issuer + client_id are required together; an empty
# client_secret means a public client):
#   HERMES_DASHBOARD_OIDC_ISSUER=
#   HERMES_DASHBOARD_OIDC_CLIENT_ID=
#   HERMES_DASHBOARD_OIDC_CLIENT_SECRET=
#   HERMES_DASHBOARD_OIDC_SCOPES=