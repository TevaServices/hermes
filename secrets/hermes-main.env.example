# Hermes "main" profile secrets — copy to /etc/hermes/hermes-main.env
# (scripts/bootstrap-host.sh) and fill in real values.
#
# Key names below come from:
#   - config/providers.toml  (api_key_env of the profile's model providers)
#   - profile.toml platforms  (gateway tokens)
#   - config/integrations.toml (required_env)
# After changing providers/models/platforms, check build/main/.env.example
# (generated by `make render`) for the current required set.

# Model providers used by this profile (models: smart -> openrouter, fast -> openrouter)
OPENROUTER_API_KEY=
# FALLBACKS for the provider set in providers.toml:
NOUS_PORTAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gateway platform (telegram)
TELEGRAM_BOT_TOKEN=

# Firecrawl (self-hosted API key — must match TEST_API_KEY in firecrawl.env)
FIRECRAWL_API_KEY=

# Honcho (only if auth is enabled on the Honcho instance)
HONCHO_API_KEY=