# Hermes "main" profile secrets — copy to /etc/hermes/hermes-main.env
# (scripts/bootstrap-host.sh) and fill in real values.
#
# Key names below come from:
#   - config/providers.toml  (api_key_env of the profile's model providers)
#   - profile.toml platforms  (gateway tokens)
#   - config/integrations.toml (required_env)
# After changing providers/models/platforms, check build/main/.env.example
# (generated by `mise run render`) for the current required set.

# All model aliases route through the Ollama Cloud provider
# (config/providers.toml) — same API key Open WebUI uses.
OLLAMA_API_KEY=

# Hermes' auxiliary side tasks (context compression, session search, web
# extract, skills hub) resolve via AUXILIARY_*_ env overrides; pinning them
# to the same Ollama Cloud endpoint on the smallest model keeps background
# token usage minimal. Leave unset to use provider auto-detection.
AUXILIARY_COMPRESSION_BASE_URL=https://ollama.com/v1
AUXILIARY_COMPRESSION_API_KEY=
AUXILIARY_COMPRESSION_MODEL=gpt-oss:20b
AUXILIARY_SESSION_SEARCH_BASE_URL=https://ollama.com/v1
AUXILIARY_SESSION_SEARCH_API_KEY=
AUXILIARY_SESSION_SEARCH_MODEL=gpt-oss:20b
AUXILIARY_WEB_EXTRACT_BASE_URL=https://ollama.com/v1
AUXILIARY_WEB_EXTRACT_API_KEY=
AUXILIARY_WEB_EXTRACT_MODEL=gpt-oss:20b
AUXILIARY_SKILLS_HUB_BASE_URL=https://ollama.com/v1
AUXILIARY_SKILLS_HUB_API_KEY=
AUXILIARY_SKILLS_HUB_MODEL=gpt-oss:20b

# Gateway platform (telegram)
TELEGRAM_BOT_TOKEN=

# Firecrawl (self-hosted API key — must match TEST_API_KEY in firecrawl.env)
FIRECRAWL_API_KEY=

# Honcho (only if auth is enabled on the Honcho instance)
HONCHO_API_KEY=