# Hermes "main" profile secrets — copy to /etc/hermes/hermes-main.env
# (scripts/bootstrap-host.sh) and fill in real values.
#
# Key names below come from:
#   - config/providers.toml  (api_key_env of the profile's model providers)
#   - profile.toml platforms  (gateway tokens)
#   - config/integrations.toml (required_env)
# After changing providers/models/platforms, check the rendered
# .env.example in the image (docker run --rm hermes-agent:v<ref> cat
# /overlay/default/.env.example) for the current required set.

# All model aliases route through the stack's LiteLLM gateway
# (config/providers.toml -> http://litellm:4000). LITELLM_API_KEY is the
# proxy's master key (LITELLM_MASTER_KEY in /etc/hermes/litellm.env) —
# keep the two in sync. The gateway holds the real upstream keys
# (Ollama Cloud, OpenRouter) and routes each model name among its group.
LITELLM_API_KEY=

# OPENAI_* mirror LITELLM_API_KEY for Hermes' provider-registry resolution.
# Not used by the custom_providers entry in config.yaml (that reads
# LITELLM_API_KEY directly), BUT the `hermes chat` first-run gate
# (_has_any_provider_configured) only looks at registry env vars — without
# these, chat exits with setup guidance even though the gateway works.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://litellm:4000

# Hermes' auxiliary side tasks (context compression, title generation,
# memory-query rewrite, vision …) are NOT configured here. Their model is a
# field on the task in config.yaml — `auxiliary.<task>.{provider, model}` —
# which render.py renders from STACK_AUX_MODELS for every profile. Measured
# live on image v2026.9.24 (2026-10-04): the image reads NO
# `AUXILIARY_<TASK>_MODEL` env var for any task except VISION, VIDEO and
# APPROVAL, so a pin written here is silently inert — every aux lane falls
# back to `auto`, i.e. the profile's PRIMARY model. That is how four lanes
# spent months believed-routed while actually running on the workhorse tier.
# Retuning a lane is an edit to STACK_AUX_MODELS (repo) or a profile's
# [config_extra.auxiliary.<task>]; see AGENTS.md §"Auxiliary side tasks".
# Leave unset for provider auto-detection.

# Gateway platform (discord) — the token's mere presence enables the
# platform (gateway/config.py _apply_env_overrides). Create the app at
# https://discord.com/developers/applications, and in the Bot tab enable
# BOTH privileged toggles: "Message Content Intent" AND "Server Members
# Intent" — the adapter requests both and discord.py refuses to connect
# without them.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs the bot may respond to (accepts
# @usernames too — resolved to IDs at startup, which needs the Members
# intent). Empty = the bot answers ANYONE who mentions it in any server
# it's in. Set at least your own ID: enable Developer Mode in Discord's
# Advanced settings, right-click your name → "Copy User ID".
DISCORD_ALLOWED_USERS=
# The stack's "home channel" — where SYSTEM messages land: gateway
# shutdown/restart notices (gateway/config.py _apply_env_overrides ->
# PlatformConfig.home_channel -> run.py's home-channel broadcast, gated by
# gateway_restart_notification, default true), the one-time
# connect-time warning, and any cron job delivered with `all`/`home`
# routing instead of an explicit target. Not the bot's chat and not a
# per-profile channel: the declared housekeeping jobs in config/cron.toml
# name this ID explicitly, and this var is what covers the messages the
# gateway raises on its own. #hermes-home. Leave empty to keep system
# messages off Discord.
DISCORD_HOME_CHANNEL=
#
# Team channel routing. External profile packages declare their OWN
# channels: each package profile's [discord] block (@@DISCORD_CHANNEL_*@@)
# is resolved from the PACKAGE's env file
# (<env-dir>/profiles.d/<package>/package.env), and the boot renderer
# generates the routing entries into this agent's gateway.profile_routes.
# Nothing package-owned lives in THIS file — the stack's own channels are
# below.
#
# Right-click the channel in Discord -> "Copy Channel ID". Leave a var
# empty and that channel is fenced out for the main bot (the boot log
# names the missing var).
DISCORD_CHANNEL_MAIN=

# The GitHub account whose repos the team workflow operates on. The queue
# scripts scope every search to it, and they REFUSE to run when it is
# empty (an empty owner searches all of GitHub and returns strangers'
# issues). Not the same thing as the App owner: it is the repos'
# namespace. This is the PERSONAL owner — searched with the profile's own
# gh auth state.
#
# NOTE the TEAM_* family's placement contract: these are read by the queue
# SCRIPTS, which run as cron `no_agent` children whose env is built by
# stripping the launch profile's non-global .env names. The entrypoint
# filters TEAM_* out of the root .env copy for exactly that reason — they
# still reach the scripts via compose `env_file:`. A profile's own .env does
# NOT deliver them to a cron script (a `no_agent` child re-loads nothing),
# so do not try to place them there. See AGENTS.md §Secrets.
TEAM_OWNER=
# ORG owners (space-separated) for the org GitHub Apps, e.g.
#   TEAM_OWNER_ORGS=AcmeCorp OtherCo
# Each is searched with that org's own App installation token (the
# org-creds descriptors the entrypoint wires from the vars below); an
# org with no resolvable credentials is an ORG CREDS MISSING incident
# (queue exit 6), never a silent skip.
TEAM_OWNER_ORGS=

# GitHub (gh CLI + git-over-HTTPS). Two modes — the GitHub App is
# preferred (least privilege, scoped to selected repos, no user
# account); GH_TOKEN (fine-grained PAT) is the fallback. Commits the
# agent creates get attributed to GH_GIT_NAME/GH_GIT_EMAIL.
#
# GitHub App mode: create the app at https://github.com/settings/apps/new
# with Contents / Issues / Pull requests read+write (Metadata read is
# mandatory), install it on the repos the agent may touch, and download
# the private key PEM to $HERMES_ENV_DIR/github-app-<profile>.pem
# (root:<host-group> 640 — mounted read-only into the profile's container;
# the default profile uses github-app-main.pem). Each profile gets its
# own app — the compose mount and GITHUB_APP_* vars are per service.
# App ID is on the app's About page; Installation ID is the number in
# the install URL (https://github.com/settings/installations/<id>).
# Installation tokens last 1h — entrypoint.sh refreshes gh every 30 min
# and git routes credentials through gh (gh auth git-credential).
# GITHUB_APP_PRIVATE_KEY_PATH is deliberately NOT set here: the PEM mount
# path is fixed by compose and the entrypoint copies the key into the
# runtime-owned tool-home, exporting the variable itself.
# Hermes' skills hub also has native app support (tools/skills_hub.py
# GitHubAuth).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
#
# ── Profile packages' credentials live in the PACKAGE's env file ────────
# An external profile package (e.g. the software-team package at
# github.com/TevaServices/hermes-software-development) carries its own
# <env-dir>/profiles.d/<package>/package.env with its PROFILE_<NAME>_*
# lines (bot tokens, GitHub App ids/identities) and its
# DISCORD_CHANNEL_<NAME> ids. The credential scripts write THERE:
#
#   python3 scripts/set-team-discord-tokens.py <profile names> \
#       --env-file profiles.d/team/package.env
#   python3 scripts/create-github-apps.py <profile names> \
#       --env-file profiles.d/team/package.env
#
# and the entrypoint loads every package.env into the boot environment
# (package values override any same-named leftover line in THIS file —
# the boot log names overrides; delete the stale line). PEMs stay HERE in
# the env dir root, named per profile: github-app-<profile>.pem (the
# entrypoint discovers them by name for every rendered profile).
#
# ── ORG Apps for the MAIN profile ────────────────────────────────────────
# An org-owned App for THIS (default) profile: created with
#   python3 scripts/create-github-apps.py --org <ORG> main
# PEM as github-app-<orgslug>-main.pem. The org's routing var — the
# author filter the self-pull queues read — is TEAM_ORG_DEV_BOT_<ORG> and
# it DOES belong here (a cron SCRIPT reads it; script children see only
# container env, which package env files never reach — see AGENTS.md
# §Secrets). A package's own org apps are declared in the package's
# package.env.
GITHUB_APP_ID_<ORG>=
GITHUB_APP_INSTALLATION_ID_<ORG>=
GH_GIT_NAME_<ORG>=
GH_GIT_EMAIL_<ORG>=
TEAM_ORG_DEV_BOT_<ORG>=

# Release agent (profile `release`). These are read by release-queue.sh, so
# they live in the stack `environment:` / compose (they reach a cron SCRIPT
# only that way — see the TEAM_* placement note above).
#   TEAM_RELEASE_STATE_DIR  where the agent's per-repo deployment state
#                           lives. Declared EXPLICITLY because a cron
#                           child's HERMES_HOME is not guaranteed to be the
#                           profile home. Default:
#                           <HERMES_HOME>/cache/release
#   TEAM_RELEASE_REPOS      space-separated owner/repo that HAVE an internal
#                           deployment (informational; the state file is what
#                           the resume lane actually reads)
#   TEAM_RELEASE_RETRY_TTL  seconds before a standing release finding is
#                           repeated (default 21600 = 6h)
#
# The alternate control plane (a SEPARATE Komodo from the homelab one —
# no shared state, servers or secrets) is reached THROUGH mach: the release
# profile's mach integration rides the LiteLLM gateway, and its Komodo calls
# are mach exec tool calls on the control-plane host with the Komodo
# service-user pair injected by NAME. No credential file exists here; the
# pair lives only in mach's sealed store on that machine, and the machine
# name + secret names ride the release state file (MACH_MACHINE /
# MACH_SECRET_NAMES) — see the team-release skill.
#
# PAT fallback: gh reads GH_TOKEN natively; entrypoint.sh wires git's
# credential helper through gh, so the token never lands in a config
# file. Also feeds Hermes' skills hub (reads GITHUB_TOKEN/GH_TOKEN).
# Prefer a fine-grained PAT scoped to just the repos the agent may touch
# with Contents/Issues/Pull requests read+write.
GH_TOKEN=
GH_GIT_NAME=
GH_GIT_EMAIL=

# Firecrawl (self-hosted API key — must match TEST_API_KEY in firecrawl.env)
FIRECRAWL_API_KEY=
# Firecrawl plugin URL — hermes' BUILT-IN web plugin reads process-env, not
# the MCP integration's mcp_env. Without it the Firecrawl SDK defaults to
# api.firecrawl.dev and the self-hosted key above is rejected ("Invalid token").
FIRECRAWL_API_URL=http://firecrawl-guard:3003

# Honcho (only if auth is enabled on the Honcho instance)
HONCHO_API_KEY=

# mach — the agent's own mach API key (mach.teva.services, org teva). Sent
# per-request THROUGH the LiteLLM gateway's true_passthrough MCP entry as
# x-mcp-mach-authorization; the gateway holds no copy. Used by the default
# profile's mach integration (config/integrations.toml). Minted with
# mach-server add-api-key; scope it to the machines the profile may exec on.
MACH_MCP_KEY=

# NetLock RMM (ENT practice fleet) — Public API v1. Base URL is the backend
# host (the web console lives on netlockrmm.tevaservices.com; the API is
# served by the server component on -backend). NOT a secret.
#
# The token itself is NOT a variable here: it lives on the host as
# $HERMES_ENV_DIR/netlock-api-token (root:group 640, like the App PEMs) —
# the whole env dir is mounted read-only at /run/hermes-pem and the
# entrypoint copies it into the default profile's tool-home on every boot;
# NETLOCK_API_TOKEN_FILE (compose/hermes.compose.yml) points at that copy.
# Hermes strips credential env vars from tool subprocesses (GHSA-rhgp-j443-p4rf),
# which is why the token travels as a file. Create/rotate it in the web
# console: Settings → API tokens (form nlk_<id>_<secret>, shown once).
#
# The API is fronted by CrowdSec, which is stricter than the app's own token
# rate limit: pace calls ≥1.2 s strictly sequentially, no parallel fan-out;
# on a 403 with an EMPTY body (the CrowdSec ban shape — no server/x-request-id
# headers) back off 45 s then 90 s, and stop for minutes after a third.
NETLOCK_API_URL=https://netlockrmm-backend.tevaservices.com

# The Honcho USER PEER every profile's memory is scoped to — the id stamped
# into each rendered honcho.json as `peerName` (with `pinUserPeer: true`;
# see render.py). It is a BOOT PLACEHOLDER, resolved at container start
# because an identifier does not belong in this public repo — the same path
# the DISCORD_CHANNEL_* ids take. Leave it unset and it expands to "".
#
# WHY IT MATTERS, measured 2026-10-04: with no declared peer the plugin uses
# whatever identity the TRANSPORT supplies — a Discord message carries one,
# a cron / Bot-Chat / CLI turn carries none, and on those the plugin gives up
# ("Honcho memory is off for this session") and stores nothing. That is why
# the four team profiles, which are cron-driven, had no Honcho memory at all:
# 327 of the 504 memory blocks ever injected across every profile were that
# notice (release 274/274, reviewer 48/48). Pinning ONE peer is correct for
# this stack because it is single-user — DISCORD_ALLOWED_USERS gates every
# channel — and it is what the plugin warns against only on a SHARED gateway,
# where it would merge distinct users onto one peer.
#
# Value: the peer id your memory is already under, i.e. your Discord user id
# for a Discord-fronted install (Developer Mode → right-click your name →
# Copy User ID). Use the SAME id the transport supplies, or the pinned peer
# and the Discord peer diverge and you get two separate memories. Setting it
# also unblocks the MEMORY.md/USER.md → Honcho seeding, which the plugin
# skips while no owner peer is declared.
HONCHO_USER_PEER=

# ── Hermes dashboard (DISABLED by default) ──────────────────────────────
# The dashboard s6 service ships in the official image, gated by
# HERMES_DASHBOARD — which is NOT flipped here: compose declares
# HERMES_DASHBOARD in the container environment, and compose environment
# values override env_file values, so setting it in THIS file does
# nothing. Flip it in the stack environment (komodo/resources.toml's
# hermes-agents `environment`, or mise.toml [env] for local runs) and
# redeploy.
#
# The auth gate engages automatically on non-loopback binds and REQUIRES
# an auth provider (upstream hardening): with HERMES_DASHBOARD=1 and
# none of the vars below set, the dashboard fails at startup and its s6
# slot restart-loops (the rest of the container is unaffected). Set all
# three BEFORE flipping the flag.
#
#   username: any non-empty name you'll type at the login page
#   password: openssl rand -hex 24  (hashed in-memory at startup; a
#             precomputed scrypt hash may be supplied instead via
#             HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH)
#   secret:   openssl rand -hex 32  (session-token signing key; left
#             empty the dashboard generates a per-process key and
#             sessions do not survive a restart)
#   Optional: HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS (default 43200).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
#
# Optional alternative provider — self-hosted OIDC instead of the
# password login (issuer + client_id are required together; an empty
# client_secret means a public client):
#   HERMES_DASHBOARD_OIDC_ISSUER=
#   HERMES_DASHBOARD_OIDC_CLIENT_ID=
#   HERMES_DASHBOARD_OIDC_CLIENT_SECRET=
#   HERMES_DASHBOARD_OIDC_SCOPES=