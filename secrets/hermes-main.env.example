# Hermes "main" profile secrets — copy to /etc/hermes/hermes-main.env
# (scripts/bootstrap-host.sh) and fill in real values.
#
# Key names below come from:
#   - config/providers.toml  (api_key_env of the profile's model providers)
#   - profile.toml platforms  (gateway tokens)
#   - config/integrations.toml (required_env)
# After changing providers/models/platforms, check build/main/.env.example
# (generated by `mise run render`) for the current required set.

# All model aliases route through the Ollama Cloud provider
# (config/providers.toml) — same API key Open WebUI uses.
OLLAMA_API_KEY=

# OPENAI_* mirror OLLAMA_API_KEY for Hermes' provider-registry resolution.
# Not used by the custom_providers entry in config.yaml (that reads
# OLLAMA_API_KEY directly), BUT the `hermes chat` first-run gate
# (_has_any_provider_configured) only looks at registry env vars — without
# these, chat exits with setup guidance even though the gateway works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ollama.com/v1

# Hermes' auxiliary side tasks (context compression, session search, web
# extract, skills hub) resolve via AUXILIARY_*_ env overrides; pinning them
# to the same Ollama Cloud endpoint on the smallest model keeps background
# token usage minimal. Leave unset to use provider auto-detection.
AUXILIARY_COMPRESSION_BASE_URL=https://ollama.com/v1
AUXILIARY_COMPRESSION_API_KEY=
AUXILIARY_COMPRESSION_MODEL=gpt-oss:20b
AUXILIARY_SESSION_SEARCH_BASE_URL=https://ollama.com/v1
AUXILIARY_SESSION_SEARCH_API_KEY=
AUXILIARY_SESSION_SEARCH_MODEL=gpt-oss:20b
AUXILIARY_WEB_EXTRACT_BASE_URL=https://ollama.com/v1
AUXILIARY_WEB_EXTRACT_API_KEY=
AUXILIARY_WEB_EXTRACT_MODEL=gpt-oss:20b
AUXILIARY_SKILLS_HUB_BASE_URL=https://ollama.com/v1
AUXILIARY_SKILLS_HUB_API_KEY=
AUXILIARY_SKILLS_HUB_MODEL=gpt-oss:20b

# Gateway platform (discord) — the token's mere presence enables the
# platform (gateway/config.py _apply_env_overrides). Create the app at
# https://discord.com/developers/applications, and in the Bot tab enable
# BOTH privileged toggles: "Message Content Intent" AND "Server Members
# Intent" — the adapter requests both and discord.py refuses to connect
# without them.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs the bot may respond to (accepts
# @usernames too — resolved to IDs at startup, which needs the Members
# intent). Empty = the bot answers ANYONE who mentions it in any server
# it's in. Set at least your own ID: enable Developer Mode in Discord's
# Advanced settings, right-click your name → "Copy User ID".
DISCORD_ALLOWED_USERS=

# GitHub (gh CLI + git-over-HTTPS). GH_TOKEN authenticates everything —
# gh reads it natively, and entrypoint.sh wires git's credential helper
# through gh, so the token never lands in a config file. Also feeds
# Hermes' skills hub (tools/skills_hub.py reads GITHUB_TOKEN/GH_TOKEN).
# Prefer a fine-grained PAT (https://github.com/settings/personal-access-tokens)
# scoped to just the repos the agent may touch (e.g. <owner>/hermes,
# <owner>/komodo) with Contents/Issues/Pull requests read+write — least
# privilege. Commits the agent creates get attributed to these:
GH_TOKEN=
GH_GIT_NAME=
GH_GIT_EMAIL=

# Firecrawl (self-hosted API key — must match TEST_API_KEY in firecrawl.env)
FIRECRAWL_API_KEY=

# Honcho (only if auth is enabled on the Honcho instance)
HONCHO_API_KEY=