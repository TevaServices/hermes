# Hermes "main" profile secrets — copy to /etc/hermes/hermes-main.env
# (scripts/bootstrap-host.sh) and fill in real values.
#
# Key names below come from:
#   - config/providers.toml  (api_key_env of the profile's model providers)
#   - profile.toml platforms  (gateway tokens)
#   - config/integrations.toml (required_env)
# After changing providers/models/platforms, check the rendered
# .env.example in the image (docker run --rm hermes-agent:v<ref> cat
# /overlay/default/.env.example) for the current required set.

# All model aliases route through the stack's LiteLLM gateway
# (config/providers.toml -> http://litellm:4000). LITELLM_API_KEY is the
# proxy's master key (LITELLM_MASTER_KEY in /etc/hermes/litellm.env) —
# keep the two in sync. The gateway holds the real upstream keys
# (Ollama Cloud, OpenRouter) and routes each model name among its group.
LITELLM_API_KEY=

# OPENAI_* mirror LITELLM_API_KEY for Hermes' provider-registry resolution.
# Not used by the custom_providers entry in config.yaml (that reads
# LITELLM_API_KEY directly), BUT the `hermes chat` first-run gate
# (_has_any_provider_configured) only looks at registry env vars — without
# these, chat exits with setup guidance even though the gateway works.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://litellm:4000

# Hermes' auxiliary side tasks (context compression, session search, web
# extract, skills hub) resolve via AUXILIARY_*_ env overrides, pinned to
# the LiteLLM gateway per the models.toml routing policy: compression
# summarizes a potentially ~1M context — it needs BOTH intelligence and a
# big window, so it rides the same glm-5.3-flash as the baseline tier;
# the light tasks (search/extract/skills hub) ride the low-intelligence
# nano tier. All model IDs carry the "ollama/" prefix that matches the
# gateway's ollama/* wildcard route. Leave unset for provider
# auto-detection.
AUXILIARY_COMPRESSION_BASE_URL=http://litellm:4000
AUXILIARY_COMPRESSION_API_KEY=
AUXILIARY_COMPRESSION_MODEL=ollama/glm-5.3-flash
AUXILIARY_SESSION_SEARCH_BASE_URL=http://litellm:4000
AUXILIARY_SESSION_SEARCH_API_KEY=
AUXILIARY_SESSION_SEARCH_MODEL=ollama/nemotron-3-nano:30b
AUXILIARY_WEB_EXTRACT_BASE_URL=http://litellm:4000
AUXILIARY_WEB_EXTRACT_API_KEY=
AUXILIARY_WEB_EXTRACT_MODEL=ollama/nemotron-3-nano:30b
AUXILIARY_SKILLS_HUB_BASE_URL=http://litellm:4000
AUXILIARY_SKILLS_HUB_API_KEY=
AUXILIARY_SKILLS_HUB_MODEL=ollama/nemotron-3-nano:30b

# Gateway platform (discord) — the token's mere presence enables the
# platform (gateway/config.py _apply_env_overrides). Create the app at
# https://discord.com/developers/applications, and in the Bot tab enable
# BOTH privileged toggles: "Message Content Intent" AND "Server Members
# Intent" — the adapter requests both and discord.py refuses to connect
# without them.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs the bot may respond to (accepts
# @usernames too — resolved to IDs at startup, which needs the Members
# intent). Empty = the bot answers ANYONE who mentions it in any server
# it's in. Set at least your own ID: enable Developer Mode in Discord's
# Advanced settings, right-click your name → "Copy User ID".
DISCORD_ALLOWED_USERS=

# GitHub (gh CLI + git-over-HTTPS). Two modes — the GitHub App is
# preferred (least privilege, scoped to selected repos, no user
# account); GH_TOKEN (fine-grained PAT) is the fallback. Commits the
# agent creates get attributed to GH_GIT_NAME/GH_GIT_EMAIL.
#
# GitHub App mode: create the app at https://github.com/settings/apps/new
# with Contents / Issues / Pull requests read+write (Metadata read is
# mandatory), install it on the repos the agent may touch, and download
# the private key PEM to /etc/hermes/github-app-<profile>.pem
# (root:ubuntu 640 — mounted read-only into the profile's container;
# the default profile uses github-app-main.pem). Each profile gets its
# own app — the compose mount and GITHUB_APP_* vars are per service.
# App ID is on the app's About page; Installation ID is the number in
# the install URL (https://github.com/settings/installations/<id>).
# Installation tokens last 1h — entrypoint.sh refreshes gh every 30 min
# and git gets a fresh token per operation (github-app-token.sh).
# GITHUB_APP_PRIVATE_KEY_PATH is deliberately NOT set here: the PEM mount
# path is fixed by compose and the entrypoint copies the key into the
# runtime-owned tool-home, exporting the variable itself.
# Hermes' skills hub also has native app support (tools/skills_hub.py
# GitHubAuth).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
#
# PAT fallback: gh reads GH_TOKEN natively; entrypoint.sh wires git's
# credential helper through gh, so the token never lands in a config
# file. Also feeds Hermes' skills hub (reads GITHUB_TOKEN/GH_TOKEN).
# Prefer a fine-grained PAT scoped to just the repos the agent may touch
# with Contents/Issues/Pull requests read+write.
GH_TOKEN=
GH_GIT_NAME=
GH_GIT_EMAIL=

# Firecrawl (self-hosted API key — must match TEST_API_KEY in firecrawl.env)
FIRECRAWL_API_KEY=

# Honcho (only if auth is enabled on the Honcho instance)
HONCHO_API_KEY=