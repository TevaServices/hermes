# Firecrawl stack secrets — copy to /etc/hermes/firecrawl.env and fill in.
# Flows into firecrawl-api and firecrawl-db via compose env_file (no
# ${} interpolation, so these never need to be shell-visible).

# API key the self-hosted API accepts (USE_DB_AUTHENTICATION=false mode).
# The firecrawl-mcp server in the Hermes containers sends this same
# value as FIRECRAWL_API_KEY — keep them in sync.
TEST_API_KEY=change-me

POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=firecrawl