# Firecrawl stack secrets — copy to /etc/hermes/firecrawl.env and fill in.
# Flows into firecrawl-api and firecrawl-db via compose env_file (no
# ${} interpolation, so these never need to be shell-visible).

# API key the self-hosted API accepts (USE_DB_AUTHENTICATION=false mode).
# The MCP servers send this same value — the agents' stdio firecrawl-mcp
# reads it as FIRECRAWL_API_KEY from the Hermes envs (hermes-main.env),
# and the compose firecrawl-mcp service reads it from THIS file under the
# same name — keep all of them in sync.
TEST_API_KEY=change-me

# Same value as TEST_API_KEY: firecrawl-mcp (compose service) reads the
# upstream credential under this name and sends it to firecrawl-guard.
FIRECRAWL_API_KEY=change-me

POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=firecrawl

# LLM wiring for Firecrawl's AI features (generic-ai.js: the default
# provider is "openai" unless OLLAMA_BASE_URL is set, with MODEL_NAME as
# the model override). Pointed at the stack's LiteLLM gateway
# (http://litellm:4000).
#
# OPENAI_API_KEY MUST be a virtual key scoped to the `firecrawl` model group,
# NOT the gateway master key. Firecrawl only ever needs that one group; the
# master key would let a compromised Firecrawl (or a page that reaches its
# extractor) call every tier and every upstream model. Mint one with:
#
#   sh scripts/mint-firecrawl-key.sh --out /etc/hermes/firecrawl-key.env
#
# then paste the key here as OPENAI_API_KEY (or merge that file). The key is
# DB-backed: deleting/recreating the LiteLLM database invalidates it, and a
# plain container restart does not re-read env_file — the next deploy does.
# Verify the scope: a /v1/chat/completions call for `firecrawl` succeeds and
# the same call for a tier (e.g. `smart`) is refused.
#
# MODEL_NAME=firecrawl is a LiteLLM routing group, NOT one of the four model
# tiers (cheap/smart/smarter/smartest): Firecrawl only ever ingests public
# web pages, and it is the one consumer that needs json_schema. It used to be
# a pair of OpenRouter `:free` models; since 2026-10-23 it is a single PAID
# endpoint — openai/gpt-oss-20b on the SHARED OpenRouter key — because the
# free endpoints kept failing upstream (429 rate-limited / 404 at the
# provider), which took /v1/extract, the v2 json-format scrapes and the
# guard's forced prompt-injection classifier down with them. This FIXES the
# old schema-bound extraction gap: Ollama Cloud strips response_format
# json_schema, so /v1/extract and v2 json-format scrapes returned json:null;
# OpenRouter passes json_schema through, so SmartScrape extraction works.
# ZDR is irrelevant for this lane (public pages only). Keep the shape for any
# other lane that can never see private data; everything else belongs on a
# tier.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://litellm:4000
MODEL_NAME=firecrawl
