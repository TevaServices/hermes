# Firecrawl stack secrets — copy to /etc/hermes/firecrawl.env and fill in.
# Flows into firecrawl-api and firecrawl-db via compose env_file (no
# ${} interpolation, so these never need to be shell-visible).

# API key the self-hosted API accepts (USE_DB_AUTHENTICATION=false mode).
# The firecrawl-mcp server in the Hermes containers sends this same
# value as FIRECRAWL_API_KEY — keep them in sync.
TEST_API_KEY=change-me

POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=firecrawl

# LLM wiring for Firecrawl's AI features (generic-ai.js: the default
# provider is "openai" unless OLLAMA_BASE_URL is set, with MODEL_NAME as
# the model override). Pointed at the stack's LiteLLM gateway
# (http://litellm:4000); OPENAI_API_KEY is the proxy's master key
# (LITELLM_MASTER_KEY in /etc/hermes/litellm.env) — keep in sync.
#
# MODEL_NAME=firecrawl is a LiteLLM routing group whose members are
# OpenRouter FREE models ONLY (google/gemma-4-31b-it:free,
# nvidia/nemotron-3-super-120b-a12b:free). This FIXES the old schema-bound
# extraction gap: Ollama Cloud strips response_format json_schema, so
# /v1/extract and v2 json-format scrapes returned json:null. OpenRouter
# passes json_schema through, so SmartScrape extraction works again.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://litellm:4000
MODEL_NAME=firecrawl
