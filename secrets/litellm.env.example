# LiteLLM proxy secrets — copy to /etc/hermes/litellm.env
# (scripts/bootstrap-host.sh) and fill in real values.
#
# This file is mounted into the litellm container (compose/litellm.compose.yml)
# and read by config/litellm.yaml via os.environ/<VAR>. It holds the keys for
# WHATEVER BACKENDS you point the four model tiers at there — add or remove
# vars to match that file, which is the one place a backend is chosen.
#
# The keys the shipped Ollama Cloud + OpenRouter config needs:

# Master key — every app (Hermes, Honcho, Firecrawl) authenticates to the
# proxy with this. Generate one: openssl rand -hex 32
LITELLM_MASTER_KEY=

# Ollama Cloud — the chat LLM provider the stack already used (same key
# Open WebUI uses). Moved here from the per-app env files now that all
# apps go through the proxy.
OLLAMA_API_KEY=

# OpenRouter — free models are json_schema-capable (Ollama Cloud strips
# response_format json_schema, which broke Firecrawl's SmartScrape
# extraction). Create a key at https://openrouter.ai/keys (free tier).
OPENROUTER_API_KEY=

# OpenRouter, second key — used by the `firecrawl` group ONLY (see
# config/litellm.yaml). The free-tier endpoints that group needs are :free
# models, and if the account's guardrail enforces ZDR they are excluded
# outright ("ZDR violation (guardrail): 1 endpoint excluded"), which 404s
# Firecrawl's extract lane. A free-models key with no ZDR guardrail fixes
# that without relaxing ZDR for the tiers. Leave empty to fall back to
# nothing — the firecrawl group will fail loudly rather than silently use
# the shared key.
OPENROUTER_FREE_KEY=

# ── Database (added when the gateway became DB-backed) ─────────────────
# Postgres that holds virtual keys, teams, budgets and the SSO user table.
# Two files share ONE generated password (both root-owned):
#   this file carries the fully-formed DSN the gateway connects with;
#   /etc/hermes/litellm-db.env carries the DB container's POSTGRES_* (see
#   litellm-db.env.example). Generate once, write both in the same sitting:
#   p=$(openssl rand -hex 16)
DATABASE_URL=postgresql://litellm:<db-password>@litellm-db:5432/litellm

# ── Admin UI SSO (Zitadel, via LiteLLM's generic OIDC provider) ────────
# The public base URL LiteLLM builds SSO redirects and callbacks from —
# must match the redirect URI registered on the OIDC app
# (https://<your-proxy-host>/sso/callback). Endpoints are the OIDC
# discovery values of the issuer (curl <issuer>/.well-known/
# openid-configuration — confirm them when the issuer changes).
PROXY_BASE_URL=https://<your-proxy-host>
GENERIC_CLIENT_ID=
GENERIC_CLIENT_SECRET=
GENERIC_AUTHORIZATION_ENDPOINT=https://<issuer-host>/oauth/v2/authorize
GENERIC_TOKEN_ENDPOINT=https://<issuer-host>/oauth/v2/token
GENERIC_USERINFO_ENDPOINT=https://<issuer-host>/oidc/v1/userinfo
# Use the stable `sub` claim as the user identity so a changed login name
# never re-creates the user.
GENERIC_USER_ID_ATTRIBUTE=sub
# SSO email gate (comma-separated; checked after login against the userinfo
# email). Empty means any Zitadel-authenticated account may reach the UI.
ALLOWED_EMAIL_DOMAINS=your-domain.com
