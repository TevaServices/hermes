# Honcho stack secrets — copy to /etc/hermes/honcho.env and fill in.

# Postgres password for honcho-db. Only used if you switch the DB off
# upstream's default trust auth (see compose/honcho.compose.yml) — keep
# it set so you can tighten auth without editing compose.
HONCHO_POSTGRES_PASSWORD=change-me

# Honcho's deriver uses an LLM to derive representations. Any
# OpenAI-compatible endpoint works (check Honcho's .env.template for
# the exact variable names your version reads — these are the defaults).
#
# Wired to Ollama Cloud here — the same API key Open WebUI uses — with a
# small model: the deriver runs in the background on every message, so
# model size is the dominant token-cost knob.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_MODEL=gpt-oss:20b
