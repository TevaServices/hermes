# Honcho stack secrets — copy to /etc/hermes/honcho.env and fill in.

# Postgres password for honcho-db. Only used if you switch the DB off
# upstream's default trust auth (see compose/honcho.compose.yml) — keep
# it set so you can tighten auth without editing compose.
HONCHO_POSTGRES_PASSWORD=change-me

# ── Chat LLMs ─────────────────────────────────────────────────────────────
# Wired to the stack's LiteLLM gateway (http://litellm:4000) — the proxy
# holds the real upstream keys and decides which backend answers. Every
# model name below is a TIER from config/models.toml (cheap / smart /
# smarter / smartest), never an upstream model id.
# LLM_OPENAI_API_KEY is the proxy's master key (LITELLM_MASTER_KEY in
# /etc/hermes/litellm.env) — keep in sync. Honcho reads LLM_-prefixed env
# vars (src/config.py LLMSettings; the bare OPENAI_API_KEY name is NOT
# read by current versions). These two cover every default model config:
# sections without their own overrides reuse the default client built
# from them (src/llm/registry.py).
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=http://litellm:4000

# Per-section model names (the default is an OpenAI model this stack's
# gateway does not serve, so they are all pinned). Split by what the section
# actually does:
#
#   volume lanes -> "cheap". The deriver runs on EVERY message, so model
#     size is the dominant token-cost knob; it is mechanical extraction, not
#     reasoning. `minimal` dialectic is light by construction (1 tool round,
#     2 tools, 250 tokens out).
#   REASONING lanes -> "smart". The dream sections deduce and induce over
#     accumulated memory (12 and 10 tool iterations, 8192 tokens out — real
#     agentic reasoning), and medium/high/max ask for depth explicitly.
#     Summaries are cheap in volume and their output is what gets surfaced to
#     the agent, so they earn the better model too. `low` is here for the
#     same reason as the dream lanes, not because of its name: it is the
#     DEFAULT level for every dialectic query (chat.py) and runs a 5-round
#     agentic loop with the full toolset — the most demanding prompt in the
#     stack, on the lane that answers most often. Moved off "cheap"
#     2026-10-04; only `minimal` stayed there.
#
# The deriver on "cheap" is the deliberate bet: it is both the single biggest
# spend lever here AND the biggest quality lever — change that one line if
# memory extraction ever looks thin.
#
# ── STRUCTURED OUTPUT: the deriver's json_schema does not survive Ollama ──
# The deriver asks for its extraction as a typed model
# (`response_model=PromptRepresentation, json_mode=True`, deriver.py:156),
# and every Ollama-backed lane on this gateway IGNORES `response_format:
# json_schema` — measured 2026-10-04: `cheap` returns truncation, `smart`
# returns markdown-FENCED prose (```json … ```), and the schema changes the
# output not at all. Honcho's pydantic parse then rejects it and the job
# errors: in honcho-db the queue held 70 errored rows, ALL of them
# `task_type='representation'`, 65 of them `ValidationError: Invalid JSON …
# for PromptRepresentation`. Net effect: 28 documents total, covering 5 of
# 188 messages (~2.7%), zero deductive/inductive documents ever, and a null
# peer card — Honcho had almost nothing to remember.
#
# `structured_output_mode: json_object` is Honcho's own answer for "providers
# without json_schema support": it injects the schema into the prompt and
# repairs the result downstream (src/llm/backends/openai.py). Verified by
# replaying the deriver's exact call against the live gateway — default mode
# extracted 0 facts, json_object extracted 3 correct ones, same `cheap` tier,
# no provider change and no extra spend:
#   mode=default(json_schema)  31.0s OK  facts=0  :: []
#   mode=json_object           26.7s OK  facts=3  :: ['bcross asked to move
#     service registration logic into the distribution packages', …]
#
# DERIVER ONLY. The dream lanes are NOT set: they call with `tools=` and no
# response_model (src/dreamer/specialists.py), so the mode does not apply to
# them — and they have never run on this stack, because they need the >=50
# documents the broken deriver never produced. Watch them when they first
# fire; if their tool loop misbehaves on an Ollama tier, that is the finding.
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
#
# Every lane but `summary` requires TOOL CALLING, and the deriver requires
# structured JSON output — so whichever model a lane points at must support
# both. Tool calling already works through this gateway (the dialectic lanes
# run multi-round tool loops); response_format is the part that does not, and
# the line above is what covers the deriver.
#
# ── RECALL SIDE (the plugin, not Honcho) ────────────────────────────────
# The auto-injected recall path is tuned in each profile's honcho.json, not
# here — timeout, dialectic level/level-cap, the injection char cap, the
# audit log and the pinned user peer are all rendered by render.py (see the
# block in render_profile and AGENTS.md §"Honcho memory"). The short version
# of why: the plugin's 30s default HTTP timeout discarded recall that really
# takes 90-270s, and a 5-round reasoning level was being spent on a
# 600-char-capped supplement.
#
# Like the other env files this one is operator-owned and sits outside the
# repo's atomicity — a stale raw ollama/<id> value still routes (the
# gateway's wildcard) but loses its declared window.
DERIVER_MODEL_CONFIG__MODEL=cheap
SUMMARY_MODEL_CONFIG__MODEL=smart
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=smart
DREAM_INDUCTION_MODEL_CONFIG__MODEL=smart
# Dialectic reasoning levels (get_chat_response / chat endpoint):
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=cheap
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=smart
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=smart
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=smart
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=smart

# ── Embeddings ─────────────────────────────────────────────────────────────
# Ollama Cloud has NO embeddings endpoint, so embeddings run on the
# stack-local `ollama` service — now proxied through LiteLLM (its
# nomic-embed-text entry points at http://ollama:11434). nomic-embed-text
# is 768-dim — EMBEDDING_VECTOR_DIMENSIONS must match BOTH the model and
# the pgvector column type (message_embeddings.embedding /
# documents.embedding were created vector(1536) by the first boot; resize
# once with ALTER TABLE ... TYPE vector(768) if switching from the default).
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://litellm:4000
# LiteLLM requires the master key for every request (the local Ollama
# ignores it). Same value as LLM_OPENAI_API_KEY above.
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=
EMBEDDING_VECTOR_DIMENSIONS=768