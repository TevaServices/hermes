# Honcho stack secrets — copy to /etc/hermes/honcho.env and fill in.

# Postgres password for honcho-db. Only used if you switch the DB off
# upstream's default trust auth (see compose/honcho.compose.yml) — keep
# it set so you can tighten auth without editing compose.
HONCHO_POSTGRES_PASSWORD=change-me

# ── Chat LLMs ─────────────────────────────────────────────────────────────
# Wired to the stack's LiteLLM gateway (http://litellm:4000) — the proxy
# holds the real upstream keys and decides which backend answers. Every
# model name below is a TIER from config/models.toml (cheap / smart /
# smarter / smartest), never an upstream model id.
# LLM_OPENAI_API_KEY is the proxy's master key (LITELLM_MASTER_KEY in
# /etc/hermes/litellm.env) — keep in sync. Honcho reads LLM_-prefixed env
# vars (src/config.py LLMSettings; the bare OPENAI_API_KEY name is NOT
# read by current versions). These two cover every default model config:
# sections without their own overrides reuse the default client built
# from them (src/llm/registry.py).
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=http://litellm:4000

# Per-section model names (the default is an OpenAI model this stack's
# gateway does not serve, so they are all pinned). Split by what the section
# actually does:
#
#   volume lanes -> "cheap". The deriver runs on EVERY message, so model
#     size is the dominant token-cost knob; it is mechanical extraction, not
#     reasoning. The minimal/low dialectic levels are light by construction.
#   REASONING lanes -> "smart". The dream sections deduce and induce over
#     accumulated memory, and the medium/high/max dialectic levels are the
#     ones explicitly asking for deeper reasoning. Summaries are cheap in
#     volume and their output is what gets surfaced to the agent, so they
#     earn the better model too.
#
# Raising the DERIVER to "smart" is the single biggest spend lever here, and
# also the biggest quality lever — change that one line if memory extraction
# ever looks thin. Raising the dream/dialectic lanes further ("smarter") is
# possible but has not been justified yet.
#
# Like the other env files this one is operator-owned and sits outside the
# repo's atomicity — a stale raw ollama/<id> value still routes (the
# gateway's wildcard) but loses its declared window.
DERIVER_MODEL_CONFIG__MODEL=cheap
SUMMARY_MODEL_CONFIG__MODEL=smart
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=smart
DREAM_INDUCTION_MODEL_CONFIG__MODEL=smart
# Dialectic reasoning levels (get_chat_response / chat endpoint):
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=cheap
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=cheap
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=smart
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=smart
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=smart

# ── Embeddings ─────────────────────────────────────────────────────────────
# Ollama Cloud has NO embeddings endpoint, so embeddings run on the
# stack-local `ollama` service — now proxied through LiteLLM (its
# nomic-embed-text entry points at http://ollama:11434). nomic-embed-text
# is 768-dim — EMBEDDING_VECTOR_DIMENSIONS must match BOTH the model and
# the pgvector column type (message_embeddings.embedding /
# documents.embedding were created vector(1536) by the first boot; resize
# once with ALTER TABLE ... TYPE vector(768) if switching from the default).
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://litellm:4000
# LiteLLM requires the master key for every request (the local Ollama
# ignores it). Same value as LLM_OPENAI_API_KEY above.
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=
EMBEDDING_VECTOR_DIMENSIONS=768