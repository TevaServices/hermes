#!/command/with-contenv sh
# shellcheck shell=sh
# Headless Chromium CDP sidecar. Serves the DevTools endpoint on
# 127.0.0.1:9333 so the browser tools (browser-harness / browser_exec)
# can attach inside the container — there is no user-facing Chrome on a
# headless server. The binary is the Playwright Chromium headless shell
# BAKED into the official hermes-agent image (PLAYWRIGHT_BROWSERS_PATH
# — no extra download); the symlink below gives it a stable path.
#
# Profile-hermes renders browser.cdp_url = http://127.0.0.1:9333, so
# Hermes' browser backend resolves BU_CDP_URL to this endpoint instead
# of trying (and failing) to discover a desktop Chrome profile.
#
# Gated by HERMES_CHROMIUM_CDP like the dashboard service (./finish
# handles the disabled case with s6's permanent-failure marker).

case "${HERMES_CHROMIUM_CDP:-}" in
    1|true|TRUE|True|yes|YES|Yes) ;;
    *)
        exit 0
        ;;
esac

SHELL_BIN="${HERMES_CHROMIUM_BIN:-/usr/local/bin/chromium-headless-shell}"
CDP_PORT="${HERMES_CHROMIUM_CDP_PORT:-9333}"
CDP_DATA=/opt/data/chromium-cdp

if [ ! -x "$SHELL_BIN" ]; then
    echo "[chromium-cdp] $SHELL_BIN missing — no pm-store Chromium and no Playwright layout in this base" >&2
    exit 0
fi

mkdir -p "$CDP_DATA"
chown hermes:hermes "$CDP_DATA" 2>/dev/null || true
# The CDP state dir must be writable by the user chrome will run as (the
# mkdir above may have run as root on a host-created dir).

# Drop to the runtime user BEFORE exec'ing chrome — upstream's own dashboard
# service does the same (s6-setuidgid hermes). This is load-bearing beyond
# hygiene: chrome running as root creates an empty root-owned mode-700
# `extensions/` probe dir INSIDE the baked PM tool store next to its own
# binary (observed every boot, 2026-10-16) — and one unreadable entry in
# /opt/hermes/tools fails the boot-time PM sync's copytree with EACCES, so
# the sync never publishes and the runtime env loses honcho-ai and the
# web plugin's firecrawl SDK (the whole trader web-tool degradation). As
# uid 10000 chrome cannot create entries in a root-owned store dir at all,
# and its own state goes to $CDP_DATA under /opt/data as before.
#
# --no-sandbox: Chrome's setuid sandbox cannot start in this container
# (no user namespaces for an unprivileged uid). The process runs as that
# unprivileged user with no access to secrets, and this is a local-only
# endpoint (binds 127.0.0.1).
exec s6-setuidgid hermes "$SHELL_BIN" \
    --headless \
    --remote-debugging-address=127.0.0.1 \
    --remote-debugging-port="$CDP_PORT" \
    --user-data-dir="$CDP_DATA" \
    --no-sandbox \
    --disable-gpu \
    --disable-dev-shm-usage \
    about:blank