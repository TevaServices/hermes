+    async def _voice_self_heal(self, guild_id: int) -> None:
+        """Rejoin voice after an external disconnect, with teardown grace."""
+        try:
+            # Discord's own handler for this event is still tearing the old
+            # VoiceClient down (it waits for the leave confirmation) -- give
+            # it a moment so our join does not race its voice-state update.
+            await asyncio.sleep(3.0)
+            if await self._rejoin_voice_channel(guild_id):
+                logger.info("[%s] Voice self-heal rejoined (guild=%d)", self.name, guild_id)
+            else:
+                logger.info(
+                    "[%s] Voice self-heal skipped (guild=%d): binding gone or no allowed user in voice",
+                    self.name,
+                    guild_id,
+                )
+        except Exception as e:
+            logger.warning("[%s] Voice self-heal error (guild=%d): %s", self.name, guild_id, e)
+
+    async def _rejoin_voice_channel(self, guild_id: int) -> bool:
+        """Rejoin a voice channel after an external session drop.
+
+        Discord terminates voice sessions server-side, which kills the
+        receiver with it -- without a rejoin the bot goes deaf AND mute
+        while its voice-mode state still says "on". Rejoin only when an
+        allowed user is actually present in a voice channel: playing into
+        an empty room is worse than the attachment fallback.
+        """
+        if not self._client or self._client.user is None:
+            return False
+        text_ch_id = self._voice_text_channels.get(guild_id)
+        if text_ch_id is None:
+            return False  # a deliberate leave already cleaned the binding up
+        guild = self._client.get_guild(guild_id)
+        if guild is None:
+            return False
+        target = None
+        for vc in guild.voice_channels:
+            for m in vc.members:
+                if m.id == self._client.user.id:
+                    continue
+                if self._is_allowed_user(str(m.id), guild=guild, is_dm=False):
+                    target = vc
+                    break
+            if target is not None:
+                break
+        if target is None:
+            return False
+        try:
+            return bool(await self.join_voice_channel(target, text_channel_id=text_ch_id))
+        except Exception as e:
+            logger.warning("[%s] Voice rejoin failed (guild=%d): %s", self.name, guild_id, e)
+            return False
+
