--- a/cron/scheduler_delivery.py
+++ b/cron/scheduler_delivery.py
@@ -737,8 +737,30 @@
     env = strip_launch_profile_env(delegated_child_subprocess_env(os.environ))
     if profile:
         argv += ["-p", profile]
-        # -p owns profile resolution; this scheduler's HERMES_HOME must not shadow it.
-        env.pop("HERMES_HOME", None)
+        # Point HERMES_HOME at the TARGET PROFILE. Neither of the two
+        # obvious alternatives is correct here:
+        #   * DROPPING it loses the root in Docker/custom layouts (profiles
+        #     live at HERMES_HOME/profiles/<name>), so the child falls back
+        #     to the native ~/.hermes and the profile does not exist at
+        #     all - every delivery dies with "Profile '<name>' does not
+        #     exist".
+        #   * KEEPING the scheduler's value leaves the child's home on the
+        #     ROOT (the default profile), so anything that resolves
+        #     credentials from the home rather than from -p -
+        #     `hermes send`'s get_hermes_home()/.env, and the GitHub App
+        #     env - acts as the DEFAULT profile. Observed live: the main
+        #     bot posted a developer status line into #dev, and the child
+        #     inherited a sibling profile's GITHUB_APP_ID.
+        # Pinning the profile dir keeps -p and the home consistent, so
+        # every .env lookup is scoped to the profile that is actually
+        # running. `-p` still owns resolution (main.py short-circuits when
+        # HERMES_HOME's parent is "profiles").
+        try:
+            from hermes_cli.profiles import get_profile_dir
+
+            env["HERMES_HOME"] = str(get_profile_dir(profile))
+        except Exception:
+            env.pop("HERMES_HOME", None)
     else:
         # Multiplex workers carry the profile in a ContextVar, not os.environ.
         env["HERMES_HOME"] = str(source_home)
