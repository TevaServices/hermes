#!/bin/sh
# gh shim — owner-based token routing for the org GitHub Apps.
#
# The real CLI lives at /usr/local/bin/gh-real (renamed at image build).
# gh keeps ONE active token per host, but every profile may hold TWO App
# credential sets (the personal App + one org App per org), so `gh`
# alone cannot reach both. This shim picks the token for the invocation:
#
#   1. args start with `auth `  -> passthrough (never second-guess auth
#      commands; gh auth login/token/status are how the personal App
#      token gets stored, and Hermes' skills-hub GitHubAuth reads it)
#   2. resolve the target owner from ARGV ONLY (a pure argv read, hoisted
#      above the GH_TOKEN passthrough so the gate in step 2b sees even
#      explicit-token calls — the queue scripts and the GH_TOKEN="$(gh-org-token …)"
#      idiom cannot route around it):
#        a) -R/--repo owner/repo in the args (attached + separated forms)
#        b) an owner-bearing `gh api` ENDPOINT PATH — repos/<owner>/… or
#           orgs/<owner> (see "gh api carries no -R" below)
#        c) the cwd git repo's origin URL
#      the same scan also captures the subcommand/action and every
#      --add-label/--remove-label/--label/-l value (comma-split),
#      which the label gate reads
#   2b. label gate — one mechanical fence at the one hop every
#      credentialed call passes through (labels are the team's routing
#      mechanism; a misfiled one takes the item out of BOTH queues):
#        review/* SET on an issue, or status/* SET on a PR -> refuse
#        (type/* is legal on both by design; --remove-label always passes)
#        from the reviewer profile, ANY gh issue edit/close/reopen ->
#        refused, routed to planner
#        refusals exit 1 with the corrected command shape on stderr and
#        gh-real is never exec'd — the message is the teaching moment
#   2c. body gate — inline `--body`/`-b` on issue/pr create|edit -> refuse,
#      name --body-file (see "the body gate" below)
#   3. resolve the owner        -> -R/--repo (step 2), else a `gh api`
#      endpoint path, else the cwd's origin. Above the passthrough because
#      the CI gate needs it.
#   4. org descriptor lookup    -> $HOME/org-creds/<owner>.env, which is what
#      tells the CI gate which identity to ask as (the mint itself is 7)
#   5. the CI gate — a write that ASSERTS a verdict on a PR (the handoff,
#      the verdict, the approval, the merge) while CI is RED or STILL
#      RUNNING -> refuse (see "the CI gate" below). The one gate that makes
#      a network call, and it FAILS OPEN on anything that is not a
#      positively observed red/running check.
#   6. GH_TOKEN is set          -> passthrough (explicit caller intent;
#      the queue scripts use this to force their own token) — AFTER the
#      gates, so preset-token calls are fenced too
#   7. owner has an org descriptor ($HOME/org-creds/<owner>.env)
#        -> mint/reuse the org token and exec gh-real with GH_TOKEN
#      (mint failure = hard error: a descriptor means the caller means
#      the ORG identity; silently using the personal token would
#      attribute org work to the wrong bot)
#   8. anything else            -> exec gh-real unchanged (personal
#      token from the tool-home's gh auth state — exactly as before)
#
# gh api CARRIES NO -R — gh's own parser rejects it ("unknown shorthand
# flag: 'R'"), so for `gh api` the endpoint path is the only owner signal
# besides the cwd. An agent doing REST work writes its payload files to a
# scratch dir, so its cwd is often NOT the worktree — and before step (b)
# existed, `gh api repos/<org>/<repo>/…` from such a cwd silently used the
# PERSONAL token and got
#
#   {"message":"Resource not accessible by integration", ... "status":"403"}
#
# on writes. That reads exactly like a missing App permission, and it is
# not one: the personal App simply has no installation on the org. Check
# what is actually granted with a USER token —
#   gh api /orgs/<org>/installations --jq '.installations[]|{app_slug,permissions}'
# (the App's own token cannot read it; 404 either way, which is its own
# false lead). The probe that misleads is a PUBLIC repo:
# `gh api repos/<org>/<public-repo> --jq .permissions` returns all-false
# under the personal token (reads work, writes do not), so it "confirms"
# a permission gap that isn't there. A PRIVATE repo is the honest probe:
# 200 under the org token, 404 under the personal one.
#
# The body gate (2c). A multi-line --body is a SHELL argument, and the shell
# expands it before gh ever runs: a backtick code span is command
# substitution, so the span is replaced by that command's stdout — the
# issue body becomes the shell's output. Observed: the planner
# filed five issues in one repo that way. `mach` is on PATH in this
# image (it is the agent binary the stack ships), and bare `mach` on an
# admin box prints the fleet table, so all five bodies carried a
# NAME/STATE/OS-ARCH/… table where the word `mach` belonged; everything
# else substituted EMPTY — `systemctl`, `.deb`, `MACH_STATE_DIR`,
# `/usr/bin/mach` — leaving sentences with literal blanks ("replacing the
# internal  mechanism"). A second escape layer bit too: the same body past
# a Python """…""" literal turned `$\rightarrow$` into a carriage return,
# breaking a line mid-sentence.
#
# The gate cannot DETECT that damage — the substitution has already
# happened by the time this script runs, so all 2c sees is the wreckage.
# What it can do is forbid the shape that makes it possible, which is the
# same move as 2b: a hard block at the one hop, with the fix in the
# message. `--body-file` always works and cannot be got wrong; a variable
# (`--body "$body"`) happens to be safe, because the shell does not re-scan
# an expansion for command substitution — but it is one quoting slip from
# being the exact bug, so it is not worth the exception.
#
# Deliberately NOT gated: `gh issue comment --body` / `gh pr comment
# --body`. A one-line comment is legitimately inline ("done", "+1"), and
# refusing it would be a false positive on correct work. A whole-body
# payload (issue/PR create|edit) is never legitimately inline — it is a
# document, and a document belongs in a file.
#
# Scope: owner detection from (a)/(b)/(c) plus TWO mechanical gates (2b
# label families, 2c inline bodies).
# The gate screens gh issue/pr edit|create label-writing flags by the
# label families' object rule — it does NOT screen `gh api` label writes:
# the endpoint scanner cannot know which args are flag values, so the
# REST-level spelling stays covered only by the queues' FOREIGN LABEL
# guard, which re-reads the real objects on every tick. Call shapes that
# name no owner anywhere still resolve from the cwd, and
# from a scratch dir that means the personal token: `gh api graphql`,
# `gh search` (its --owner is a filter, and one search can span owners),
# and a `repos/{owner}/{repo}` endpoint there (gh expands those placeholders
# from the cwd and fails outright without one). Force the org identity for
# those with GH_TOKEN="$(gh-org-token <slug>)". See the hermes-stack-ops
# skill.
set -u

# Overridable so the routing decision can be tested offline against a stub
# (scripts/test-gh-shim.sh) — no network, no container.
GH_REAL="${GH_REAL:-/usr/local/bin/gh-real}"
[ -x "$GH_REAL" ] || { echo "gh shim: gh-real missing" >&2; exit 127; }

# --- 1. gh auth * always passes through -------------------------------------
for arg in "$@"; do
    [ "$arg" = "auth" ] && exec "$GH_REAL" "$@"
done

# --- 2. target owner + label capture (argv only) -----------------------------
# Scan ALL args: -R/--repo in every spelling gh accepts (separated,
# `-R=owner/repo`, and attached `-Rowner/repo`), the
# `gh repo <view|clone|create|…> owner/repo` positional form, and enough
# flag-arity awareness to skip the VALUES of -R/--repo and --hostname so
# neither can be mistaken for a subcommand. Value confusion is the hazard
# of any argv scan; the values consumed here are just those two flags'
# plus the label flags' (see 2b).
#
# This scan is a pure argv read and sits ABOVE the GH_TOKEN passthrough
# (step 6) on purpose: the gates in 2b/2c/5 must see preset-token calls
# too — the queue scripts set GH_TOKEN on every gh call, so a gate below
# the passthrough would fence nothing that matters.
#
# The same loop also captures, for 2b:
#   action      — the first positional after the subcommand. gh's grammar
#                 puts the verb directly after the subcommand
#                 (`gh issue edit 7 …`), so this is reliable for
#                 edit/create/close/reopen.
#   add_labels  — --add-label/--label/-l values in every spelling gh
#                 accepts (separated, `=`, attached), comma-split, stored
#                 newline-separated (labels never word-split). NB: a
#                 `--label` FILTER on list/view is captured too, but the
#                 gate reads it only for edit/create — filters pass.
#   rm_labels   — --remove-label values (captured, never gated: removing a
#                 wrong-family label is the undo the FOREIGN LABEL guard
#                 prints, and a removal can only improve the lane).
#   body_inline — set when an inline --body/-b is present on issue/pr; the
#                 gate in 2c reads it. --body-file is captured by NONE of
#                 these arms (a long flag's attached form requires `=`, so
#                 `--body` and `--body=…` are the complete spellings) —
#                 which is what keeps the file shape passing.
owner=""
owner_repo=""
subcmd=""
action=""
pr_num=""
approve=""
add_labels=""
rm_labels=""
body_inline=""
positional=""
prev=""
nl='
'
for arg in "$@"; do
    case "$prev" in
        -R|--repo) owner="$arg"; owner_repo="$arg"; prev=""; continue ;;
        # --body/-b take a value, and that value is a whole document: it
        # must be swallowed here or a body line could be read as the
        # action/subcommand.
        --body|-b)
            case "$subcmd" in issue|pr) body_inline=yes ;; esac
            prev=""; continue ;;
        # --hostname takes a value too. Swallowing it keeps `subcmd` honest
        # for `gh --hostname github.com api repos/…` — otherwise the value
        # becomes the subcommand and the api-path scan below never runs.
        --hostname) prev=""; continue ;;
        # Label flags take values as well. Captured only for issue/pr — the
        # families' rule is object-scoped (`gh label list` keeps its own
        # meaning), and `gh search --label` is an AND of filters, not a set.
        --add-label|--remove-label|--label|-l)
            case "$subcmd" in issue|pr)
                case "$prev" in
                    --remove-label) rm_labels="$rm_labels${rm_labels:+$nl}$arg" ;;
                    *) add_labels="$add_labels${add_labels:+$nl}$arg" ;;
                esac ;;
            esac
            prev=""; continue ;;
    esac
    prev=""
    case "$arg" in
        --) break ;;
        -R=*) owner="${arg#-R=}"; owner_repo="$owner" ;;
        --repo=*) owner="${arg#--repo=}"; owner_repo="$owner" ;;
        -R|--repo) prev="$arg" ;;
        --hostname) prev="$arg" ;;
        # Attached shorthand (`-Rowner/repo`), which gh's flag parser accepts.
        # Without this arm it fell to `-*)` and the call silently used the
        # personal token — the same failure this file's header describes.
        -R?*) owner="${arg#-R}"; owner_repo="$owner" ;;
        # Label flags in the attached spellings gh accepts (the separated
        # forms are handled by the prev-arm above).
        --add-label=*) add_labels="$add_labels${add_labels:+$nl}${arg#--add-label=}" ;;
        --remove-label=*) rm_labels="$rm_labels${rm_labels:+$nl}${arg#--remove-label=}" ;;
        --label=*) add_labels="$add_labels${add_labels:+$nl}${arg#--label=}" ;;
        -l=*) add_labels="$add_labels${add_labels:+$nl}${arg#-l=}" ;;
        -l?*) add_labels="$add_labels${add_labels:+$nl}${arg#-l}" ;;
        --add-label|--remove-label|--label|-l) prev="$arg" ;;
        # Inline body, attached spellings. `--body-file` matches no arm
        # here on purpose (see body_inline above).
        --body=*) case "$subcmd" in issue|pr) body_inline=yes ;; esac ;;
        -b=*) case "$subcmd" in issue|pr) body_inline=yes ;; esac ;;
        -b?*) case "$subcmd" in issue|pr) body_inline=yes ;; esac ;;
        --body|-b) prev="$arg" ;;
        # A boolean flag with no value, captured for the CI gate (5):
        # `gh pr review --approve` IS the approval, and it must not land on a
        # head CI has not blessed any more than the label may.
        --approve) approve=yes ;;
        -*) ;;
        *)
            if [ -z "$subcmd" ]; then subcmd="$arg"; continue; fi
            # The action (first positional after the subcommand) — only
            # meaningful for issue/pr, which is exactly where the gate
            # reads it; leaving it uncaptured elsewhere keeps `gh repo
            # clone owner/repo`'s positional-owner detection intact.
            if [ -z "$action" ] && { [ "$subcmd" = issue ] || [ "$subcmd" = pr ]; }; then
                action="$arg"; continue
            fi
            # The number — the first positional AFTER the action, captured
            # for pr only. `gh pr edit|review|merge <N>` puts it there, and
            # the CI gate (5) needs it to query the checks; `issue|pr
            # create` has none, and nothing to query.
            if [ "$subcmd" = pr ] && [ -z "$pr_num" ]; then
                pr_num="$arg"; continue
            fi
            # `gh repo <view|clone|create|…> owner/repo`: the positional
            # IS the target — but only when it carries the owner part
            # (`gh repo view proj` derives the owner from cwd itself and
            # must passthrough). Other subcommands' positionals are
            # ignored: their targets arrive via -R/--repo or context.
            if [ "$subcmd" = "repo" ] && [ -z "$positional" ]; then
                case "$arg" in
                    */*) positional="$arg" ;;
                esac
            fi
            ;;
    esac
done
[ -n "$owner" ] || owner="$positional"

# --- 2b. the label gate ------------------------------------------------------
# One mechanical fence at the one hop every credentialed GitHub call passes
# through. Labels ARE the team's routing mechanism and each queue polls one
# family on one object kind, so a misfiled label is not untidiness — it
# takes the item out of BOTH queues at once while it still looks busy
# (observed 2026-09-25: two profiles traded the same issue every 5-minute
# tick). Refusals exit 1 with the corrected shape on stderr and gh-real is
# never exec'd — hard block, never auto-correct (same precedent as the
# org-fallback refusal); the message is the teaching moment.
# NOT screened, stated honestly: `gh api` label writes — the endpoint
# scanner cannot know which args are flag values; the REST spelling stays
# covered by the queues' FOREIGN LABEL guard, which re-reads the real
# objects on every tick.
is_reviewer() {
    # ${HERMES_HOME:-} — a bare expansion dies under set -u where the var
    # is unset; inside the s6 gateway it is always set, which is why this
    # worked there and exploded anywhere else (observed as "HERMES_HOME:
    # unbound variable" from test-gh-shim.sh on a laptop).
    case "${HERMES_HOME:-}" in
        */profiles/reviewer|*/profiles/reviewer/) return 0 ;;
    esac
    case "${HOME:-}" in
        */profiles/reviewer/home|*/profiles/reviewer/home/) return 0 ;;
    esac
    return 1
}
if [ "$subcmd" = issue ] || [ "$subcmd" = pr ]; then
    # Rule 1 (family/object, profile-agnostic): review/* SET on an issue,
    # or status/* SET on a PR. type/* is legal on BOTH by design — it
    # classifies the change, it does not hand it off; the release filing
    # (`gh issue create --label type/bug --label status/ready`) passes.
    if [ -n "$add_labels" ]; then
        case "$subcmd" in
            issue) case "$action" in edit|create) gate=yes ;; esac ;;
            pr)    case "$action" in edit|create) gate=yes ;; esac ;;
        esac
        [ "${gate:-}" = yes ] || gate=no
    else
        gate=no
    fi
    if [ "$gate" = yes ]; then
        bad=""
        # Values may be comma-joined ("type/bug,review/ready" — the exact
        # shape the 2026-09-25 misfile took), so split every value at
        # commas BEFORE the family match: a whole-value glob would only
        # catch lists whose FIRST member is foreign.
        all_labels=""
        for v in $add_labels; do           # newline-separated first level
            case "$v" in
                *,*)
                    oldIFS=$IFS; IFS=,
                    for c in $v; do all_labels="$all_labels${all_labels:+$nl}$c"; done
                    IFS=$oldIFS ;;
                *) all_labels="$all_labels${all_labels:+$nl}$v" ;;
            esac
        done
        for l in $all_labels; do           # newline-separated, never word-split
            case "$subcmd:$l" in
                issue:review/*|pr:status/*) bad="$bad $l" ;;
            esac
        done
        if [ -n "$bad" ]; then
            fixrem=""
            for l in $bad; do fixrem="$fixrem --remove-label $l"; done
            if [ "$subcmd" = issue ]; then
                {
                    echo "gh shim: refused: review/* is a PR-family label —$bad does not belong on an issue (an issue carrying it is invisible to BOTH queues)."
                    echo "  Undo the misfile:   gh issue edit <ISSUE#> --repo <owner>/<repo>$fixrem"
                    echo "  The handoff belongs on the PR; the PR for the issue is the one whose body says Closes #<ISSUE#>:"
                    echo "    gh pr edit <PR#> --repo <owner>/<repo> --add-label review/ready"
                    echo "  Also restore the card: gh issue edit <ISSUE#> --repo <owner>/<repo> --add-label status/ready (planner's routing move the developer's queue re-picks)."
                } >&2
            else
                {
                    echo "gh shim: refused: status/* is an ISSUE-family label —$bad does not belong on a PR (the PR lane reads review/* only)."
                    echo "  Undo the misfile:   gh pr edit <PR#> --repo <owner>/<repo>$fixrem"
                    echo "  The card state belongs on the issue this PR closes: gh issue edit <ISSUE#> --repo <owner>/<repo> --add-label status/…"
                } >&2
            fi
            exit 1
        fi
    fi
    gate=""
    # Rule 2 (the reviewer fence): the reviewer does not edit issue cards.
    # PR writes and issue COMMENTS stay open; the card is planner's. Fails
    # open when the profile signal is absent (default home, human shells,
    # cron children) — Rule 1 backstops label misfiles profile-agnostically.
    if [ "$subcmd" = issue ] && is_reviewer; then
        case "$action" in
            edit|close|reopen)
                {
                    echo "gh shim: refused: the reviewer does not edit issues — labels are the routing mechanism and the card is planner's to move."
                    echo "  Route it: comment @hermes-planner on the PR/issue naming the state the verdict implies."
                    echo "  Your writes live on the PR (review/* labels, the verdict) — issue comments stay open to you."
                } >&2
                exit 1 ;;
        esac
    fi

    # Rule 3 (the body gate, profile-agnostic): no inline --body/-b on a
    # whole-body write. See "the body gate" in the header — the shim sees
    # the damage only after the shell has done it, so the defensible move
    # is to refuse the shape. create|edit only: those payloads are
    # documents, and a document belongs in a file. `gh issue comment
    # --body` stays open (a one-line comment is legitimately inline), and
    # --body-file passes untouched.
    if [ -n "$body_inline" ]; then
        case "$action" in
            create|edit)
                {
                    echo "gh shim: refused: inline --body on $subcmd $action — the shell expands it BEFORE gh runs, so a backtick code span is command substitution and the body becomes that command's output."
                    echo "  (Observed: five issues in one repo were filed this way. \`mach\` is on PATH here, so bare \`mach\` printed the fleet table into the body; \`systemctl\`, \`.deb\` and \`MACH_STATE_DIR\` substituted empty and left blanks mid-sentence.)"
                    echo "  Write the body to a file, then:"
                    echo "    gh $subcmd $action <N> --repo <owner>/<repo> --body-file <path>"
                    echo "  An ALREADY-corrupted body is repaired, not just avoided: re-read it (gh $subcmd view <N> --json body) and check every code span and path survived."
                } >&2
                exit 1 ;;
        esac
    fi
fi

# --- 3. resolve the owner (endpoint path, then cwd) --------------------------
# This used to run BELOW the explicit-token passthrough, which was fine while
# the only gates were argv-shape reads. It cannot stay there now: the CI gate
# (5) needs the owner, and it must sit ABOVE the passthrough, or a preset
# GH_TOKEN routes around it — the same reasoning that put the label gate above
# it. Both scans below are read-only (argv, and one `git remote get-url`), so
# hoisting them costs a preset-token call nothing but a subprocess.

# --- 3a. `gh api` names the owner in the ENDPOINT PATH -----------------------
# `gh api` defines no -R/--repo (see the header), so for it the path is the
# only owner signal the invocation carries. Matching is deliberately STRICT
# and anchored — `repos/<owner>/<repo>…` or `orgs/<owner>…`, with an
# optional leading slash and/or query string — because this loop cannot know
# which args are flag VALUES: `-f key=repos/a/b` and `--input out.json` must
# keep falling through, and an anchored match cannot hit them. (Endpoint
# first in argv is the normal spelling; a relative `--input repos/…` before
# the endpoint would be read as the endpoint — accepted, since it needs a
# directory literally named `repos/`.)
if [ -z "$owner" ] && [ "$subcmd" = "api" ]; then
    for arg in "$@"; do
        ep="${arg%%\?*}"                          # a query string is not the path
        case "$ep" in                             # gh accepts a full URL endpoint
            https://*|http://*) ep="${ep#*://}"; ep="${ep#*/}" ;;
        esac
        ep="${ep#/}"                              # `gh api /repos/…` is valid
        case "$ep" in
            repos/*/*) seg="${ep#repos/}"; seg="${seg%%/*}" ;;
            orgs/*)    seg="${ep#orgs/}";  seg="${seg%%/*}" ;;
            *) continue ;;
        esac
        # GitHub owners are [A-Za-z0-9-]. Anything else is NOT an owner: it
        # is gh's own {owner}/{repo} placeholder (gh expands those from the
        # cwd — treating "{owner}" as a literal owner would drop a call that
        # works today onto the personal token), or a percent-encoded
        # spelling. Leave those to the cwd fallback below.
        case "$seg" in ''|*[!A-Za-z0-9-]*) continue ;; esac
        owner="$seg"
        break
    done
fi

if [ -z "$owner" ]; then
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
       || git rev-parse --is-inside-git-dir >/dev/null 2>&1; then
        url="$(git remote get-url origin 2>/dev/null)" || url=""
        case "$url" in
            https://github.com/*) owner="${url#https://github.com/}" ;;
            git@github.com:*)     owner="${url#git@github.com:}" ;;
            ssh://git@github.com/*) owner="${url#ssh://git@github.com/}" ;;
            *) owner="" ;;
        esac
    fi
fi
# The CI gate (below) needs the FULL owner/repo; the truncation throws the repo
# away. Both values come from the same two sources (an explicit -R/--repo, or
# the cwd's origin URL), so keep the whole one beside the owner. A trailing
# `.git` (the cwd spelling) is not part of a repo name.
[ -n "$owner_repo" ] || owner_repo="$owner"
owner_repo="$(printf '%s' "${owner_repo%.git}" | tr -d '[:space:]')"
owner="$(printf '%s' "$owner" | cut -d/ -f1 | tr -d '[:space:]')"
[ -n "$owner" ] || exec "$GH_REAL" "$@"

# --- 4. org descriptor? -------------------------------------------------------
creds_dir="${ORG_CREDS_DIR:-}"
[ -n "$creds_dir" ] || creds_dir="${HOME:-}/org-creds"
owner_slug="$(printf '%s' "$owner" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9')"
desc=""
if [ -n "$owner_slug" ] && [ -d "$creds_dir" ]; then
    for f in "$creds_dir"/*.env; do
        [ -f "$f" ] || continue
        if [ "$(basename "$f" .env | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9')" = "$owner_slug" ]; then
            desc="$f"
            break
        fi
    done
fi

# --- 5. the CI gate ----------------------------------------------------------
# CI is the gateway on CI, and a green local run is not a CI verdict. A write
# that ASSERTS a verdict on a PR may not land while a check is red or still
# running: the developer's handoff (review/ready), the reviewer's verdict
# (review/approved, and the `pr review --approve` that IS the GitHub approval),
# and the merge. On a repo whose ruleset requires no status checks a red check
# never appears in mergeStateStatus at all, so `gh pr checks` is the only read
# that sees it.
#
# It FAILS OPEN, deliberately. The query is an API call, so a result that is
# not a POSITIVELY observed red/running check — no checks configured, no
# network, no permission, an unparseable answer — passes through. A gate that
# blocks on "I could not tell" reads as a permission problem, which is the trap
# this file's header warns about; the skills' prose is still the rule.
#
# NOT gated: a rejection. `review/changes`, and the claim that swaps
# review/ready -> review/in-progress, must always be possible — a red PR the
# reviewer cannot even pick up is a PR nobody can send back.
checks_gate() {
    [ "$subcmd" = pr ] || return 0
    norm="$(printf '%s' "$add_labels" | tr '\n' ',')"
    gated=""
    case "$action" in
        edit)   case ",$norm," in
                    *,review/ready,*|*,review/approved,*) gated=yes ;;
                esac ;;
        review) [ "${approve:-}" = yes ] && gated=yes ;;
        merge)  gated=yes ;;
    esac
    [ "$gated" = yes ] || return 0
    case "$pr_num" in ''|*[!0-9]*) return 0 ;; esac
    case "$owner_repo" in */*) ;; *) return 0 ;; esac

    # The token this check must run under: an explicit GH_TOKEN (the caller's
    # own choice, and the queue scripts' forced calls), else the org
    # descriptor's mint for this owner, else gh-real's stored personal token.
    # A mint failure HERE is not fatal — it means no answer, which fails open;
    # the refusal for a mint failure is step 7's, not this gate's.
    ci_token=""
    if [ -n "${GH_TOKEN:-}" ]; then
        ci_token="$GH_TOKEN"
    elif [ -n "$desc" ]; then
        ci_token="$(gh-org-token "$owner_slug" 2>/dev/null)" || ci_token=""
    fi

    # gh's own --jq does the parsing (there is no `jq` on this image) and it
    # reports the same bucket names the skills read: pass|fail|pending|
    # skipping|cancel. The no-checks case prints nothing and exits non-zero.
    if [ -n "$ci_token" ]; then
        buckets="$(GH_TOKEN="$ci_token" "$GH_REAL" pr checks "$pr_num" \
                     --repo "$owner_repo" --json bucket \
                     --jq '[.[].bucket]|unique|join(",")' 2>/dev/null)"
    else
        buckets="$("$GH_REAL" pr checks "$pr_num" --repo "$owner_repo" \
                     --json bucket --jq '[.[].bucket]|unique|join(",")' 2>/dev/null)"
    fi
    [ -n "$buckets" ] || return 0

    state=""
    oldIFS=$IFS; IFS=,
    for b in $buckets; do
        case "$b" in
            fail|cancel|cancelled) state="red" ;;          # red outranks running
            pending) [ -n "$state" ] || state="running" ;;
        esac
    done
    IFS=$oldIFS
    [ -n "$state" ] || return 0

    case "$state" in
        red)     headline="CI is RED ($buckets) on $owner_repo#$pr_num" ;;
        running) headline="CI is still RUNNING ($buckets) on $owner_repo#$pr_num" ;;
    esac
    case "$action" in
        merge) why="Nothing merges with CI red: a merge is the one write no later check can undo." ;;
        edit)  case ",$norm," in
                   *,review/ready,*) why="review/ready is the handoff — it goes on only once every check is terminal and GREEN, never while one is still running." ;;
                   *) why="review/approved is the verdict — an approval over a red or running check blesses a revision CI never ran." ;;
               esac ;;
        *)     why="An approval blesses a revision, and CI has not blessed this one." ;;
    esac
    {
        echo "gh shim: refused: $headline — gh-real was not run."
        echo "  A green local run is not a CI verdict. On a repo whose ruleset requires"
        echo "  no status checks, a red check never appears in mergeStateStatus at all:"
        echo "  \`gh pr checks\` is the only read that shows it."
        echo "  $why"
        echo "  Watch it to completion, then run the command again:"
        echo "    gh pr checks $pr_num --repo $owner_repo --watch"
    } >&2
    return 1
}
checks_gate || exit 1

# --- 6. explicit token wins ---------------------------------------------------
# BELOW the gate, deliberately — the same reason the label gate is above it:
# the queue scripts set GH_TOKEN on every gh call, and the documented way to
# force an org token is `GH_TOKEN="$(gh-org-token <slug>)"`, so a gate below
# this line would fence nothing that matters.
[ -n "${GH_TOKEN:-}" ] && exec "$GH_REAL" "$@"

# --- 7. mint the org token and exec -------------------------------------------
# A descriptor means the caller means the ORG identity; silently using the
# personal token would attribute org work to the wrong bot.
if [ -z "$desc" ]; then
    exec "$GH_REAL" "$@"
fi

if ! token="$(gh-org-token "$owner_slug")"; then
    echo "gh shim: no org token for '$owner' — refusing to fall back to the personal App for an org-owned repo" >&2
    exit 1
fi
GH_TOKEN="$token" exec "$GH_REAL" "$@"